# ============================================================
# specc 项目 .gitignore
# 核心安全原则：任何密钥/凭证/引擎本地配置绝不入库
# ============================================================

# ---- 密钥与凭证（最高优先级防护）----
*.env
.env.*
secrets/
*.key
*.pem
# 阿里云百炼 / DashScope 密钥可能出现的文件
dashscope*.json
.codex/

# ---- Codex 引擎本地配置（含端点/密钥引用，属个人本地配置）----
codex-local.toml

# ---- 操作系统与编辑器 ----
.DS_Store
.idea/
.vscode/
*.swp

# ---- 构建产物（三工程目录未来会产生）----
node_modules/
dist/
build/
target/
*.class
*.jar
.gradle/

# ---- 日志与临时文件 ----
*.log
tmp/
.specc-cache/
