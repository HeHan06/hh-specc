<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiguide.admin.mapper.AdminUserMapper">
    <resultMap id="AdminUserMap" type="com.aiguide.admin.domain.AdminUser">
        <constructor>
            <arg column="id" javaType="long"/>
            <arg column="username" javaType="string"/>
            <arg column="password_hash" javaType="string"/>
            <arg column="role" javaType="string"/>
            <arg column="status" javaType="string"/>
        </constructor>
    </resultMap>

    <select id="selectByUsername" resultMap="AdminUserMap">
        SELECT id,
               username,
               password_hash,
               role,
               status
        FROM admin_user
        WHERE username = #{username}
    </select>

    <insert id="insertAdminUser">
        INSERT INTO admin_user (username, password_hash, role, status)
        VALUES (#{username}, #{passwordHash}, #{role}, #{status})
    </insert>
</mapper>
