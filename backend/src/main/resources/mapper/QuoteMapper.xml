<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dailyquote.quote.mapper.QuoteMapper">

    <!--
      查询指定展示日期的已上架语录。
      展示日期在服务端按 Asia/Shanghai 计算后传入，避免依赖数据库会话时区。
    -->
    <select id="selectPublishedByDisplayDate" resultType="com.dailyquote.quote.dto.QuoteView">
        SELECT content,
               source,
               background_image,
               display_date
        FROM quote
        WHERE display_date = #{displayDate}
          AND status = 'published'
        LIMIT 1
    </select>

</mapper>
